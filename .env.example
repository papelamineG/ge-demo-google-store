# ==============================================================================
# Google Store Hardware Operations — Gemini Enterprise Demo Configuration
# ==============================================================================
# NOTE: You do NOT need to manually copy this file before running the installer!
# Simply run `bash setup_and_deploy.sh` and it will interactively detect your
# active gcloud project/account and generate `.env` automatically.
#
# If you prefer non-interactive/CI deployment, copy `.env.example` to `.env`
# and fill in `PROJECT_ID` and `GCP_ACCOUNT`.
# ==============================================================================

PROJECT_ID="your-gcp-project-id"
REGION="europe-west1"
GCP_ACCOUNT="your-email@your-domain.com"

# Demo Identity & Resource Naming
SUFFIX="2654"
DOMAIN_SLUG="google-store"
COMPANY_NAME="Google Store"
AGENT_NAME="ge-agent-google-store-2654"
AGENT_DISPLAY_NAME="Google Store Operations Assistant (2654)"
AGENT_DESCRIPTION="Google Store AI Agent for Customer Hardware Order, European Fulfillment & RMA Warranty Intelligence"
SERVICE_NAME="ge-agent-google-store-2654"
BIGQUERY_DATASET="demo_google_store_2654"
DATASET_ID="demo_google_store_2654"
FIRESTORE_COLLECTION="demo-google-store-2654-tasks"

# Runtime Flags
GOOGLE_GENAI_USE_VERTEXAI="1"
GOOGLE_CLOUD_LOCATION="global"
DEMO_LANGUAGE="English"
DEMO_COHORT_KEY="order_placed_at"
DEMO_COHORT_LABEL="2026-08-26 -> 2026-09-17"
DEMO_METRIC_PROVENANCE="hub_inventory.on_hand_stock / reserved_preorders; rma_defect_records.refund_credit_eur"

# Auto-populated by setup_and_deploy.sh during deployment:
DATA_VIEWER_URL=""
SANDBOX_ENGINE_ID=""
GCS_BUCKET_NAME=""
DATASTORE_SCOPE_IDS=""
GE_APP_ID=""
GE_LOCATION=""
